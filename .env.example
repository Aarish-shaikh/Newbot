# ==========================================
# DOMAIN & HTTPS (Caddy Automatic SSL)
# ==========================================
# Point your DuckDNS / custom domain to your VM's public IP
DOMAIN=bot.yourdomain.duckdns.org
SERVER_URL=https://bot.yourdomain.duckdns.org
PORT=8080

# ==========================================
# EVOLUTION API MASTER AUTHENTICATION
# ==========================================
AUTHENTICATION_TYPE=apikey
AUTHENTICATION_API_KEY=your_secure_master_api_key_at_least_32_chars
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=true

# ==========================================
# DATABASE (PostgreSQL - Internal to Docker)
# ==========================================
POSTGRES_USER=evolution
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=evolution

# ==========================================
# REDIS CACHE (Internal to Docker)
# ==========================================
CACHE_REDIS_ENABLED=true
CACHE_REDIS_PREFIX_KEY=evolution-api:
CACHE_REDIS_SAVE_INSTANCES=true

# ==========================================
# GENERAL EVOLUTION BEHAVIOR
# ==========================================
DEL_INSTANCE=false
CONFIG_SESSION_PHONE_CLIENT=Evolution API
CONFIG_SESSION_PHONE_NAME=Chrome

# ==========================================
# TARGET INSTANCE CONFIGURATION
# ==========================================
MY_INSTANCE_NAME=newbot

# The URL of your bot logic (Google Apps Script webhook URL or custom server)
MY_WEBHOOK_URL=https://script.google.com/macros/s/your-google-script-id/exec

# Optional: Chatwoot integration (if you choose to use Chatwoot support inbox)
CHATWOOT_URL=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_TOKEN=

# ==========================================
# FRIEND'S SERVER (Read-Only Export Reference)
# ==========================================
FRIEND_SERVER_URL=http://129.159.231.246:8080
FRIEND_API_KEY=your_friends_api_key_here
FRIEND_INSTANCE_NAME=bot
